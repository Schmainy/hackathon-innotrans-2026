# --- Required: Azure OpenAI ------------------------------------------------
AZURE_OPENAI_API_KEY=your-value-here
# Base URL (https://<resource>.openai.azure.com/) or full Responses URL
AZURE_OPENAI_ENDPOINT=your-value-here
AZURE_OPENAI_DEPLOYMENT=your-value-here

# Alternative names for the same three values (read directly by the code):
# AZURE_API_KEY=your-value-here
# AZURE_ENDPOINT=your-value-here
# MODEL_NAME=your-value-here
# AZURE_MODEL=your-value-here

# --- Optional (defaults in brackets) ---------------------------------------
# DATA_DIR=your-value-here               # data folder [./data]
# OPENAI_API_VERSION=your-value-here     # [from endpoint URL, else 2025-04-01-preview]
# AGENT_TIMEOUT_S=your-value-here        # seconds per question [26]
# LLM_BACKEND=your-value-here            # azure_responses | azure | openai | json | anthropic [azure_responses]
# HOST=your-value-here                   # FastAPI host [127.0.0.1]
# PORT=your-value-here                   # FastAPI port [8000]
# AUDIT_LOG=your-value-here              # audit log of the FastAPI agent [audit_log.jsonl]

# Streamlit app / agent CLI
# UBAHN_DATA=your-value-here             # data folder [DATA_DIR]
# UBAHN_BACKEND=your-value-here          # [LLM_BACKEND]
# UBAHN_MODEL=your-value-here            # [MODEL_NAME]
# UBAHN_AUDIT=your-value-here            # [audit_log.jsonl]
# UBAHN_FEEDBACK=your-value-here         # [feedback_log.jsonl]
# UBAHN_EXPERT=your-value-here           # 1 = expert mode [0]
# UBAHN_ANSWER_STYLE=your-value-here     # concise | detailed [concise]
# UBAHN_SELF_CHECK=your-value-here       # 0 = no figure self-check [1]

# Only for LLM_BACKEND=openai / json (OpenAI-compatible endpoint)
# OPENAI_BASE_URL=your-value-here
# OPENAI_API_KEY=your-value-here
# Only for LLM_BACKEND=anthropic (read by the anthropic SDK)
# ANTHROPIC_API_KEY=your-value-here
